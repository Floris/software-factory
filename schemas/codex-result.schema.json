{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Software Factory Codex Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "changed_files", "validations", "risks"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "needs_review", "blocked", "failed"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "changed_files": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "validations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "not_run"]
          },
          "detail": { "type": "string" }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "blocker": { "type": "string" },
    "recommended_next_step": { "type": "string" }
  }
}
